# ── Python 运行产物 ──────────────────────────────────────
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ── 虚拟环境 ────────────────────────────────────────────
.venv/

# ── 密钥与本地配置（.env.example 必须保留）───────────────
.env
.env.*
!.env.example

# ── 运行时日志（每跑一次就长，且含请求细节）────────────────
logs/
*.log

# ── 评估产物（报告每次跑都新增一个，不入库）────────────────
# 需要留证据时：把某一份复制成 eval/sample-report.md 再提交
eval/report-*.md

# ── 临时文件 ────────────────────────────────────────────
*.tmp
tmp/
