# ── Python 运行产物 ──────────────────────────────────────
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ── 虚拟环境 ────────────────────────────────────────────
.venv/

# ── 密钥与本地配置（.env.example 必须保留）───────────────
.env
.env.*
!.env.example

# ── 运行时日志（每跑一次就长，且含请求细节）────────────────
logs/
*.log

# ── 评估产物（报告每次跑都新增一个，不入库）────────────────
# 需要留证据时：把某一份复制成 eval/sample-report.md 再提交
eval/report-*.md

# ── 临时文件 ────────────────────────────────────────────
*.tmp
tmp/

# ── 数据与索引 ──────────────────────────────────────────
# 语料 data/docs/*.md 必须入库：它是知识资产，也是评估结果可复现的前提。
# data/index/ 是语料的派生产物，不入库，理由三条：
#   1) vectors.npy 是二进制，进 git 只会污染 diff，体积随语料线性增长；
#   2) 重建只需几秒（模型已缓存），没有存档价值；
#   3) 索引带语料指纹（corpus.fingerprint），缺失或过期都会自动重建。
data/index/
